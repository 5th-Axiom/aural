# Copy to .env.test.local. One literal KEY=value per line; no shell expansion.
NEXT_PUBLIC_APP_URL=https://aural-test.example.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Empty relay URLs use same-origin /ws/voice through the HTTPS gateway.
NEXT_PUBLIC_VOICE_RELAY_PRIMARY=voice
NEXT_PUBLIC_VOICE_RELAY_URL=
NEXT_PUBLIC_OPENAI_VOICE_RELAY_URL=

ASR_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
DASHSCOPE_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
TTS_PROVIDER=tokendance
TOKENDANCE_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_VOICE_ZH=zh_female_shuangkuaisisi_uranus_bigtts
DOUBAO_VOICE_EN=en_female_dacey_uranus_bigtts

RELAY_LLM_PROVIDER=openai
RELAY_LLM_API_KEY=
RELAY_LLM_BASE_URL=https://api.deepseek.com/v1
RELAY_LLM_MODEL=deepseek-chat
RELAY_LLM_TEMPERATURE=0
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
GENERATOR_MODEL=deepseek-chat
REPORT_MODEL=deepseek-chat

# 本期手机号登录模拟：任意非空手机号 + 123456
MOCK_PHONE_AUTH_ENABLED=true
# 至少 32 字符的随机值，保持稳定；不要放入 NEXT_PUBLIC_*
MOCK_PHONE_AUTH_SECRET=
